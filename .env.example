# API Keys for the 3 AI Models
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Custom API base URLs (if using direct APIs or custom wrappers like OpenRouter)
# OpenAI default is https://api.openai.com/v1
OPENAI_API_BASE=https://api.openai.com/v1

# MetaTrader 5 Account Settings (Optional - if left blank, it will connect to the currently active MT5 terminal)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=VTMarkets-Server

# Telegram Alerts (Optional - set to true and fill in token/chat_id to receive trade notifications)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
