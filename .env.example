# ============================================================================
#               TRADING BOT CONFIGURATION (.env.example)
# ============================================================================

# ----------------------------------------------------------------------------
# 1. AI MODEL API KEYS & MODEL SELECTION
# ----------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# API Base URLs
OPENAI_API_BASE=https://api.openai.com/v1
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# Models & Fallbacks
CLAUDE_MODEL=deepseek/deepseek-v4-flash
CLAUDE_FALLBACK_MODEL=claude-haiku-4-5-20251001
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
OPENAI_MODEL=gpt-5.4-mini
OPENAI_FALLBACK_MODEL=gpt-5.4-mini
LLM_TIMEOUT_SECONDS=24.0

# ----------------------------------------------------------------------------
# 2. METATRADER 5 ACCOUNT & RPC BRIDGE
# ----------------------------------------------------------------------------
MT5_HOST=localhost
MT5_PORT=18812
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=VTMarkets-Live 3
MAGIC_NUMBER=20260625

# ----------------------------------------------------------------------------
# 3. TRADING PARAMETERS & RISK-BASED SIZING
# ----------------------------------------------------------------------------
WEEKDAY_SYMBOL=XAUUSD-ECNc
WEEKEND_SYMBOL=XAUUSD-ECNc
SYMBOL=XAUUSD-ECNc
TIMEFRAME=M5
STARTING_BALANCE=1000.0

# Lot Size & Risk Percentage (% of equity per trade)
LOT_SIZE=0.01
LOT_SIZE_XAU=0.01
LOT_SIZE_BTC=0.01
RISK_PERCENT_XAU=0.5
RISK_PERCENT_BTC=1.5
DEVIATION=20

# Stop Loss & Take Profit Rules & Defaults
# TP_SL_RULES mode: "ATR-Based" (floor 1.2x ATR, TP >= 1.5x SL) or "LLM" (bebas sesuai thesis AI, floor 2x spread)
TP_SL_RULES=ATR-Based
DEFAULT_SL_POINTS=300
DEFAULT_TP_POINTS=600
SL_ATR_MULTIPLIER=1.5
TP_ATR_MULTIPLIER=3.0

# ----------------------------------------------------------------------------
# 4. BOT MODE & CONSENSUS SETTINGS
# ----------------------------------------------------------------------------
# DRY_RUN=false -> LIVE trading. Set to true for simulation mode.
DRY_RUN=false
TRADING_PAUSED=false

# Consensus Thresholds
CONSENSUS_THRESHOLD=2
CONFIDENCE_CONSENSUS_THRESHOLD_XAU=1.0
CONFIDENCE_CONSENSUS_THRESHOLD_BTC=1.2
MIN_CONSENSUS_MODELS=2

# Feature Toggles
FORCE_ACTIVE_ENTRY=false
DYNAMIC_CONFIG_ENABLED=false
QUANT_ANALYSIS_ENABLED=false
MONTE_CARLO_ENABLED=false
FORECAST_ENABLED=true
MEMORY_CONTEXT_ENABLED=true
DEBATE_ENABLED=false

# ----------------------------------------------------------------------------
# 5. EXECUTION ENGINE (Trailing Stop, Break-Even, Partial Close)
# ----------------------------------------------------------------------------
TRAILING_STOP_ENABLED=true
TRAILING_ACTIVATION_POINTS=200
TRAILING_DISTANCE_POINTS=150

BREAK_EVEN_ENABLED=true
BREAK_EVEN_TRIGGER_POINTS=300
BREAK_EVEN_PADDING_POINTS=10

PARTIAL_CLOSE_ENABLED=true
PARTIAL_CLOSE_PERCENT=50.0
PARTIAL_CLOSE_TP1_POINTS=400

# ----------------------------------------------------------------------------
# 6. RISK MANAGEMENT & PROTECTION LIMITS
# ----------------------------------------------------------------------------
MAX_DAILY_LOSS_USD=50.0
MAX_CONSECUTIVE_LOSSES=5
PAUSE_AFTER_LOSSES_MINUTES=15
MAX_OPEN_POSITIONS=6
MAX_OPEN_POSITIONS_RECOVERY=4
BREAK_EVEN_TOLERANCE_USD=0.04

RECOVERY_MODE_ENABLED=true
RECOVERY_LOT_MULTIPLIER=0.5
RECOVERY_EXIT_PROFIT_USD=0.10

MAX_SPREAD_POINTS=50
MAX_SPREAD_POINTS_XAU=50
MAX_SPREAD_POINTS_BTC=2400

SESSION_FILTER_ENABLED=true
WEEKEND_CLOSE_ENABLED=true
WEEKEND_TRADING_ENABLED=false

# ----------------------------------------------------------------------------
# 7. TELEGRAM ALERTS & DASHBOARD API HTTP
# ----------------------------------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

API_BASE_URL=http://localhost:8765
API_TOKEN=

# ----------------------------------------------------------------------------
# 8. MEME COIN & CRYPTO SCANNER
# ----------------------------------------------------------------------------
MEME_SCANNER_ENABLED=false          # Enable automated meme coin & crypto scanner
MEME_SCAN_INTERVAL_MINUTES=30       # Scan cadence in minutes (M30 candles)
MEME_SCAN_LLM_ENABLED=false         # Stage 2: Send top candidates to LLM consensus
MEME_MAX_SPREAD_ATR_RATIO=0.30      # Max spread/ATR ratio (0.30 = 30%)
MEME_MIN_ATR_PERCENT=1.0            # Min ATR % volatility (1.0 = 1%)
MEME_RISK_PERCENT=0.5               # Risk % per meme coin trade
MEME_SCAN_TOP_N=3                   # Top N recommendations to display/alert
