# ============================================================
#  TRADING BOT CONFIGURATION (.env.example)
#  Salin file ini menjadi .env lalu isi API key & parameter Anda.
# ============================================================

# ---------- API KEYS (4 AI Models) ----------
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ---------- API BASE URL (opsional, custom wrapper) ----------
OPENAI_API_BASE=https://api.openai.com/v1
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# ---------- MT5 ACCOUNT ----------
# Mode: "live" | "demo"
MT5_ACCOUNT_MODE=live

# MT5 Live Account
MT5_LIVE_LOGIN=27556325
MT5_LIVE_PASSWORD=your_password_here
MT5_LIVE_SERVER=VTMarkets-Live 3

# MT5 Demo Account
MT5_DEMO_LOGIN=1157958
MT5_DEMO_PASSWORD=your_demo_password_here
MT5_DEMO_SERVER=VTMarkets-Demo

# ---------- TELEGRAM ALERTS ----------
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_API_BASE=https://tg-proxy-vercel-eight.vercel.app
TELEGRAM_NOTIFY_HOLD=true

# ---------- TRADING MODE & POOL ----------
WEEKDAY_SYMBOL=GBPUSD-ECNc
# Mode: "xau" (XAU only) | "xau_pairs" (8 FX Pairs Pool)
TRADING_MODE=xau_pairs
# Pool FX: 8 Pair FX (GBPUSD, USDCAD, EURJPY, GBPAUD, AUDCAD, EURCHF, AUDCHF, CADCHF)
FX_PAIR_SYMBOLS=GBPUSD-ECNc,USDCAD-ECNc,EURJPY-ECNc,GBPAUD-ECNc,AUDCAD-ECNc,EURCHF-ECNc,AUDCHF-ECNc,CADCHF-ECNc
# Max simbol dalam rotasi pool
MAX_ROTATION_SYMBOLS=8
# Rotasi ke BTC di weekend / setelah jam 22:00 Jumat
ENABLE_BTC_ROTATION=false
# Timeframe utama: M30 (XAU/BTC), H1 (FX)
TIMEFRAME=M30

# ---------- AI MODELS & MODE ----------
OPENAI_MODEL=o4-mini
OPENAI_DEFAULT_MODEL=o4-mini
OPENAI_FALLBACK_MODEL=o3-mini
OPENAI_REASONING_EFFORT=low

DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_EFFORT=low

CLAUDE_MODEL=claude-haiku-4-5-20251001

GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_BUDGET=1024
# GEMINI_API_BASE=https://generativelanguage.googleapis.com

# AI Mode: "schedule" (otomatis by WIB) | "fixed"
AI_MODE_POLICY=schedule
AI_DUAL_SECOND_MODEL=Gemini

# ---------- RISK & LOT SIZING ----------
# Risk per trade (% equity) — per kategori
RISK_PERCENT_BTC=1.5
RISK_PERCENT_XAU=1.0
RISK_PERCENT_FX=1.25

# Limits & Protection
MAX_DAILY_LOSS_USD=50.0
DAILY_PROFIT_TARGET_PERCENT=6.0
MAX_OPEN_POSITIONS=5
MAX_OPEN_POSITIONS_RECOVERY=3
MAX_OPEN_POSITIONS_LATE_NY=2

MAX_CONSECUTIVE_LOSSES=5
PAUSE_AFTER_LOSSES_MINUTES=15
BREAK_EVEN_TOLERANCE_USD=0.04
RECOVERY_EXIT_PROFIT_USD=0.10
RECOVERY_LOT_MULTIPLIER=0.5
TRADE_COOLDOWN_SECONDS=0

# ---------- SL/TP RULES (Mode LLM) ----------
# Floor SL FX = multiplier x ATR H1 (1.3x ATR H1)
LLM_FX_FLOOR_ATR_MULT=1.3
# Floor SL XAU = multiplier x ATR M30 (1.2x ATR M30)
LLM_XAU_FLOOR_ATR_MULT=1.2
# Fallback floor (pts) kalau ATR gagal dihitung
LLM_SAFETY_FLOOR_FX_PTS=250
LLM_SAFETY_FLOOR_XAU_PTS=400
# R:R minimum (TP >= x * SL)
LLM_MIN_RR_RATIO=1.25
# Gate OVER-RISK: SL yang risk aktualnya > % ini di min lot = ditolak
OVER_RISK_MAX_PERCENT=2.0
# Mode SL/TP: "LLM" (per-kategori, default) | "ATR-Based" (force semua)
TP_SL_RULES=LLM

# ---------- PENDING ORDER (LIMIT/STOP DARI AI) ----------
PENDING_ORDERS_ENABLED=true
PENDING_ORDER_EXPIRY_MINUTES=120
PENDING_ORDER_MAX_ACTIVE=2
PENDING_ENTRY_MIN_SPREAD_MULT=2.0
PENDING_ENTRY_MAX_ATR_MULT=1.5

# ---------- SPREAD FILTER (pts) ----------
MAX_SPREAD_POINTS_BTC=2400
MAX_SPREAD_POINTS_XAU=50

# ---------- SESSION & PROTEKSI ----------
SESSION_FILTER_ENABLED=true
DANGER_ZONES_WIB=02:00-07:00
WEEKEND_CLOSE_ENABLED=true
WEEKEND_CLOSE_PROFIT_MIN_USD=1.0
WEEKEND_CLOSE_HOURS_BEFORE=2.0
WEEKEND_MAX_LOSS_TO_HOLD_USD=20.0
WEEKEND_TRADING_ENABLED=false

# ---------- FEATURE FLAGS ----------
QUANT_ANALYSIS_ENABLED=false
MONTE_CARLO_ENABLED=false
FORECAST_ENABLED=false
MEMORY_CONTEXT_ENABLED=false
PATTERN_WHISPER_ENABLED=true
MTF_ANALYSIS_ENABLED=true
FUNDAMENTAL_ANALYSIS_ENABLED=false

# ---------- POSITION MANAGEMENT ----------
TRAILING_STOP_ENABLED=true
TRAILING_ACTIVATION_TP_PCT=0.58
TRAILING_DISTANCE_MIN_POINTS_FX=25
BREAK_EVEN_ENABLED=true
BREAK_EVEN_TRIGGER_TP_PCT=0.35
PARTIAL_CLOSE_ENABLED=false
POSITION_MANAGER_MAX_TICK_AGE_SECONDS=300

# ---------- EKSEKUSI ----------
DRY_RUN=false
DEVIATION=30
DEVIATION_XAU=60
DEVIATION_BTC=1000
MAGIC_NUMBER=20260625
