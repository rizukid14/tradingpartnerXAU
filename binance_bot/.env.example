# Binance API (buat di https://www.binance.com/en/my/settings/api-management)
# Permission: Enable Spot & Margin Trading. Withdraw WAJIB OFF.
# Testnet: https://testnet.binance.vision/ (uang virtual)
BINANCE_API_KEY=
BINANCE_SECRET=

# TESTNET=true (default, aman) | false = LIVE (uang asli)
TESTNET=true
# DRY_RUN=true (default, sinyal saja) | false = kirim order beneran
DRY_RUN=true

# LLM API keys (reuse dari bot MT5)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Opsional
# BINANCE_SYMBOL=BTCUSDT
# TELEGRAM_ENABLED=false
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
