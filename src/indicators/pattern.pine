indicator("Auto Pattern Detector Targets [MarkitTick]", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500, max_bars_back=1000)

// ── INPUTS ──────────────────────────────────────────────────────────────────
grp_gen = "General"
grp_pat = "Patterns"
grp_piv = "Pivot"
grp_vis = "Vis"
grp_flt = "Filters"
string GRP_DASH = "📊 Dashboard Settings"

cooldown          = input.int(5,      "Pattern Cooldown (Bars)",    minval=1,    group=grp_gen)
sym_tol           = input.float(10.0, "Symmetry Tolerance (%)",     minval=1.0,  step=0.5,  group=grp_gen) / 100
lvl_tol           = input.float(3.0,  "Level Tolerance (%)",        minval=0.1,  step=0.1,  group=grp_gen) / 100
min_size_pct      = input.float(0.5,  "Min Pattern Size (% of Price)", minval=0.1, group=grp_gen) / 100
min_atr_mult      = input.float(1.0,  "Min Pattern Size (ATR Multiplier)", minval=0.1, step=0.1, group=grp_gen)

show_dt_top       = input.bool(true,  "Double Top",                 group=grp_pat)
show_dt_bot       = input.bool(true,  "Double Bottom",              group=grp_pat)
show_tt_top       = input.bool(true,  "Triple Top",                 group=grp_pat)
show_tt_bot       = input.bool(true,  "Triple Bottom",              group=grp_pat)
show_hs_std       = input.bool(true,  "Head and Shoulders",         group=grp_pat)
show_hs_inv       = input.bool(true,  "Inverted Head and Shoulders",group=grp_pat)
show_flag_bull    = input.bool(true,  "Bullish Flag",               group=grp_pat)
show_flag_bear    = input.bool(true,  "Bearish Flag",               group=grp_pat)
show_pennant_bull = input.bool(true,  "Bullish Pennant",            group=grp_pat)
show_pennant_bear = input.bool(true,  "Bearish Pennant",            group=grp_pat)
show_wedge_rise   = input.bool(true,  "Rising Wedge",               group=grp_pat)
show_wedge_fall   = input.bool(true,  "Falling Wedge",              group=grp_pat)
